# Set these on Velixir -> Environment. Never commit the real .env or passwords.
ATIA_PUBLIC_URL=https://yalah.velixir.run
ATIA_ADMIN_USER=admin
ATIA_ADMIN_PASSWORD=

# Let the host set PORT. Its current HTTP port is 8080, not the phone's 443.
# PORT=8080
# ATIA_DATA_DIR=/tmp/atiaatashin-data
# Do NOT enable the following flag unless a REAL persistent volume is mounted.
# ATIA_PERSISTENT_STORAGE=true
